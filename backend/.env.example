# Copy to .env, generate independent random secrets (at least 32 bytes).
# Local disposable cluster ONLY: loopback trust; hosted DSNs need password + TLS.
APP_MODE=local_live
DATABASE_URL=postgresql+psycopg://siaga_runtime@127.0.0.1:54329/siaga_dev
MIGRATION_DATABASE_URL=postgresql://siaga_owner@127.0.0.1:54329/siaga_dev
RUNTIME_DB_ROLE=siaga_runtime
JWT_SECRET=
JWT_ISSUER=siaga-bencana
JWT_AUDIENCE=siaga-mobile
JWT_TTL_SECONDS=3600
MEDIA_SIGNING_SECRET=
STORAGE_BACKEND=local
STORAGE_ROOT=.storage/local_live
# Optional alias of STORAGE_ROOT; if both are supplied they must agree.
# LOCAL_STORAGE_DIR=.storage/local_live
STORAGE_BUCKET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Slice 1 has no ingestion worker. These settings reserve the locked names.
BMKG_SYNC_ENABLED=false
SYNC_INTERVAL_SECONDS=300
# simulation requires an explicit UTC clock, a DB ending _simulation,
# and STORAGE_ROOT ending simulation. Never point it at the live database.
SIMULATION_CLOCK=
# For Flutter web development only; mobile native does not need CORS.
CORS_ORIGINS=[]
